# ===== Application =====
APPLICATION_PORT=4000
APPLICATION_URL=http://localhost:4000
ALLOWED_ORIGINS=https://localhost:3000

# ===== Database (PostgreSQL) =====
POSTGRES_PRISMA_URL=postgresql://postgres:postgres@localhost:5433/pantry-chef
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pantry-chef
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ===== Redis =====
REDIS_URL=redis://localhost:6379
REDIS_USER=default
REDIS_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Session =====
SESSION_SECRET=change-me-to-a-random-string
SESSION_NAME=pantry-chef.sid
SESSION_FOLDER=pantry-chef:sess:
SESSION_MAX_AGE=7d
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# ===== Cookies =====
COOKIES_SECRET=change-me-to-a-random-string

# ===== Mail (SMTP) =====
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_LOGIN=your-email@example.com
MAIL_PASSWORD=your-mail-password
MAIL_FROM=noreply@example.com

# ===== AI =====
# Провайдер AI: openrouter | ollama
AI_PROVIDER=openrouter
# Модели (id зависят от выбранного провайдера; ниже — примеры для OpenRouter)
AI_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
AI_RECIPE_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
AI_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# OpenRouter (обязателен при AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-your-api-key

# Ollama (используется при AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
# Окно контекста (дефолт Ollama — 4096, этого мало для генерации рецептов)
OLLAMA_NUM_CTX=16384

# ===== OAuth Providers =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
