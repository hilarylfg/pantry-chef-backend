# ===== Application =====
APPLICATION_PORT=4000
APPLICATION_URL=http://localhost:4000
ALLOWED_ORIGINS=https://localhost:3000

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pantry-chef
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pantry-chef
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ===== Redis =====
REDIS_URI=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=password

# ===== Session =====
SESSION_SECRET=change-me-to-a-random-string
SESSION_NAME=pantry-chef.sid
SESSION_FOLDER=pantry-chef:sess:
SESSION_MAX_AGE=7d
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# ===== Cookies =====
COOKIES_SECRET=change-me-to-a-random-string

# ===== Mail (SMTP) =====
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_LOGIN=your-email@example.com
MAIL_PASSWORD=your-mail-password
MAIL_FROM=noreply@example.com

# ===== AI (OpenRouter) =====
OPENROUTER_API_KEY=sk-or-v1-your-api-key

# ===== OAuth Providers =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
