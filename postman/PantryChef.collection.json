    {
      "name": "🔑 2FA Flow",
      "description": "Поток двухфакторной авторизации.\n1. Включите 2FA через PATCH /users/me (isTwoFactorEnabled: true).\n2. Войдите без code → сервер ответит, что нужен код, и пришлёт его на почту.\n3. Войдите повторно с code → успех и session-cookie.",
      "item": [
        {
          "name": "1. Enable 2FA 🔒",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Анна Соколова\",\n  \"email\": \"{{email}}\",\n  \"isTwoFactorEnabled\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            }
          },
          "response": []
        },
        {
          "name": "2. Login (no code) → server sends code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Сервер ответит сообщением «требуется код» и отправит код на почту."
          },
          "response": []
        },
        {
          "name": "3. Login (with code) → session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Подставьте код из письма в поле `code`. При успехе выставляется session-cookie."
          },
          "response": []
        }
      ]
    },
